# ========================================
# PARADISE PERFUME - Environment Variables
# ========================================

# Server Configuration
PORT=5000
SERVER_URL=http://localhost:5000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ========================================
# DATABASE CONFIGURATION
# ========================================
# MongoDB Atlas (Cloud - Recommended)
# Get your connection string from: https://cloud.mongodb.com/
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/perfume_db

# OR MongoDB Local
# MONGO_URI=mongodb://localhost:27017/perfume_db

# ========================================
# AUTHENTICATION
# ========================================
# Generate a strong random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ========================================
# EMAIL CONFIGURATION (Gmail)
# ========================================
# 1. Enable 2-Step Verification in Gmail
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# ========================================
# VNPAY PAYMENT GATEWAY
# ========================================
# Register at: https://sandbox.vnpayment.vn/
# Get credentials from: https://sandbox.vnpayment.vn/merchantv2/
# Important: Demo credentials DO NOT work! You must register your own account.

VNPAY_TMN_CODE=YOUR_8_CHAR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_32_CHAR_HASH_SECRET_UPPERCASE_AND_NUMBERS
VNPAY_HOST=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ========================================
# MOMO PAYMENT GATEWAY
# ========================================
# Register at: https://developers.momo.vn/
# Create test app and get credentials

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API=https://test-payment.momo.vn/v2/gateway/api/create

# ========================================
# NOTES
# ========================================
# 1. Never commit the actual .env file to git
# 2. Copy this file to .env and fill in your values
# 3. Keep your .env file secure and never share it
# 4. Use different credentials for development and production
# 5. For production, use environment variables from your hosting provider
