@startuml Paradise_Perfume_Use_Case

' ========================================
' PARADISE PERFUME - USE CASE DIAGRAM
' Thiết kế theo mẫu đơn giản, dễ hiểu
' ========================================

left to right direction
skinparam packageStyle rectangle

' ========================================
' ACTORS
' ========================================

actor "Admin" as Admin
actor "Khách hàng đã đăng nhập" as Customer  
actor "Khách vãng lai" as Guest

' Quan hệ kế thừa
Customer --|> Guest

' ========================================
' HỆ THỐNG
' ========================================

rectangle "Hệ thống" {

  ' ======================================
  ' QUẢN TRỊ VIÊN (ADMIN)
  ' ======================================
  
  (Quản lý sản phẩm) as UC_AdminProducts
  (Quản lý danh mục) as UC_AdminCategories
  (Quản lý người dùng) as UC_AdminUsers
  (Quản lý đơn hàng) as UC_AdminOrders
  (Quản lý nhận hàng) as UC_AdminShipping
  (Quản lý phản hồi) as UC_AdminFeedback
  (Quản lý bài đăng) as UC_AdminBlog
  (Quản lý loại khuyến mãi) as UC_AdminPromotions
  (Quản lý khuyến mãi) as UC_AdminCoupons
  (Quản lý loại ship) as UC_AdminShippingTypes
  (Quản lý đơn hàng) as UC_AdminOrderManage
  (Quản lý so nhận) as UC_AdminReceive
  (Quản lý nhà cung cấp) as UC_AdminSuppliers
  (Quản lý nhập hàng) as UC_AdminImport
  
  ' ======================================
  ' KHÁCH HÀNG ĐÃ ĐĂNG NHẬP
  ' ======================================
  
  (Quản lý đặt chỗ cá nhân) as UC_MyBookings
  (Quản lý thông tin cá nhân) as UC_MyProfile
  (Xem lịch sử mua hàng) as UC_OrderHistory
  (Xem thông tin khuyến mãi cá loại) as UC_ViewPromotions
  (Đăng ký tài khoản) as UC_Register
  (Đặt hàng thanh toán) as UC_Checkout
  (Đặt hàng thanh toán) as UC_Payment
  (Thiết lập phản áng giỏ hàng) as UC_AddToCart
  (Bình luận đánh giá) as UC_Review
  
  ' ======================================
  ' KHÁCH VÃNG LAI
  ' ======================================
  
  (Xem danh sách sản phẩm) as UC_ViewProducts
  (Xem tin tức bài đăng) as UC_ViewBlogs
  
}

' ========================================
' CONNECTIONS - ADMIN
' ========================================

Admin --> UC_AdminProducts
Admin --> UC_AdminCategories
Admin --> UC_AdminUsers
Admin --> UC_AdminOrders
Admin --> UC_AdminShipping
Admin --> UC_AdminFeedback
Admin --> UC_AdminBlog
Admin --> UC_AdminPromotions
Admin --> UC_AdminCoupons
Admin --> UC_AdminShippingTypes
Admin --> UC_AdminOrderManage
Admin --> UC_AdminReceive
Admin --> UC_AdminSuppliers
Admin --> UC_AdminImport

' ========================================
' CONNECTIONS - CUSTOMER
' ========================================

Customer --> UC_MyBookings
Customer --> UC_MyProfile
Customer --> UC_OrderHistory
Customer --> UC_ViewPromotions
Customer --> UC_Register
Customer --> UC_Checkout
Customer --> UC_Payment
Customer --> UC_AddToCart
Customer --> UC_Review

' ========================================
' CONNECTIONS - GUEST
' ========================================

Guest --> UC_ViewProducts
Guest --> UC_ViewBlogs

@enduml
